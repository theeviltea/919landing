---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/onest';
import '../styles/global.css';
import fs from 'node:fs';
import { copy, SOCIAL, STORE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const logo = fs.readFileSync('public/img/logo.svg', 'utf8').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

// Casting wall: the 919 pattern tile cut into 4×5 cells; some cells flip to people.
const cells = Array.from({ length: 20 }, (_, i) => ({ col: i % 4, row: Math.floor(i / 4) }));
// Licensed stock photos only (no generated or web-sourced faces).
const faces = ['f-pink-skirt', 'f-headphones', 'f-yellow-suit', 'f-guitar-electric', 'f-makeup', 'f-videographer', 'f-dj', 'f-photographer', 'f-guitar-hat', 'f-guitar-acoustic', 'f-yellow-lips'];

const apple = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.37 12.7c-.02-2.1 1.72-3.12 1.8-3.17-.98-1.43-2.5-1.63-3.04-1.65-1.29-.13-2.52.76-3.18.76-.66 0-1.67-.74-2.75-.72-1.41.02-2.72.82-3.45 2.09-1.47 2.55-.38 6.33 1.06 8.4.7 1.01 1.53 2.15 2.62 2.11 1.05-.04 1.45-.68 2.72-.68 1.27 0 1.63.68 2.74.66 1.13-.02 1.85-1.03 2.54-2.05.8-1.17 1.13-2.3 1.15-2.36-.03-.01-2.2-.85-2.21-3.39ZM14.3 6.53c.58-.7.97-1.68.86-2.65-.83.03-1.84.55-2.44 1.25-.53.62-1 1.61-.88 2.56.93.07 1.88-.47 2.46-1.16Z"/></svg>';
const play = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M3.6 2.2 13.4 12l-9.8 9.8c-.36-.2-.6-.58-.6-1.05V3.25c0-.47.24-.85.6-1.05Z"/><path fill="#FBBC04" d="m16.7 15.3-3.3-3.3 3.3-3.3 3.72 2.12c.79.45.79 1.6 0 2.05l-3.72 2.43Z"/><path fill="#4285F4" d="M16.7 8.7 13.4 12 3.6 2.2c.3-.17.68-.2 1.05 0l12.05 6.5Z"/><path fill="#EA4335" d="M16.7 15.3 4.65 21.8c-.37.2-.75.17-1.05 0L13.4 12l3.3 3.3Z"/></svg>';
const check = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const fire = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.5c3.9 0 6.75-2.7 6.75-6.5 0-3.2-2-5.8-3.6-7.4-.45-.45-1.2-.13-1.2.5 0 1.2-.75 2.4-1.9 2.4-1.3 0-1.85-1.25-1.55-2.75.3-1.55.1-3.4-1.25-4.85-.4-.4-1.05-.2-1.15.35C7.7 6.1 5.25 8.5 5.25 13.4c0 4.7 2.85 8.1 6.75 8.1Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>';
const steps = { talent: t.roles.talent, employer: t.roles.employer };
const flash = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.22 2.35 5.23 11.33c-.51.66-.1 1.68.67 1.68h3.4c.5 0 .9.46.9 1.02v6.95c0 .94 1.03 1.38 1.58.67l7-8.98c.5-.66.1-1.69-.68-1.69h-3.4c-.5 0-.9-.45-.9-1.01V3.02c0-.94-1.03-1.38-1.58-.67Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>';
const star = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.6l2.2 4.5 4.9.7-3.6 3.5.9 4.9L12 15.9l-4.4 2.3.9-4.9-3.6-3.5 4.9-.7L12 4.6Z" fill="currentColor"/></svg>';
const availFaces = [
  { f: 'f-pink-skirt', name: 'Layla H.' },
  { f: 'f-yellow-lips', name: 'Zara K.' },
  { f: 'f-headphones', name: 'Karim A.' },
];
const plans = { talent: t.pricing.talent, employer: t.pricing.employer };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#3F94FF" />
    <link rel="alternate" hreflang="en" href="https://919app.net/" />
    <link rel="alternate" hreflang="ru" href="https://919app.net/ru/" />
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'ru' ? 'К содержимому' : 'Skip to content'}</a>

    <!-- Nav -->
    <header class="nav" data-nav>
      <div class="nav__in">
        <a href={lang === 'ru' ? '/ru/' : '/'} class="nav__logo" aria-label="919"><Fragment set:html={logo} /></a>
        <nav class="nav__links" aria-label="Main">
          <a href="#how">{t.nav.talent}</a>
          <a href="#how" data-role-link="employer">{t.nav.employers}</a>
          <a href="#features">{t.nav.features}</a>
          <a href="#pricing">{t.nav.pricing}</a>
          <a href="#faq">{t.nav.faq}</a>
        </nav>
        <div class="nav__end">
          <a class="nav__lang" href={t.nav.langHref} hreflang={lang === 'ru' ? 'en' : 'ru'}>{t.nav.lang}</a>
          <a class="btn btn--ink nav__cta" href="#download">{t.nav.download}</a>
          <button class="nav__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="menu" data-burger><span></span><span></span></button>
        </div>
      </div>
    </header>
    <!-- Outside the header: its backdrop-filter would trap a fixed child. -->
    <div class="menu" id="menu" hidden data-menu>
      <a href="#how">{t.nav.talent}</a>
      <a href="#how" data-role-link="employer">{t.nav.employers}</a>
      <a href="#features">{t.nav.features}</a>
      <a href="#pricing">{t.nav.pricing}</a>
      <a href="#faq">{t.nav.faq}</a>
      <a href={t.nav.langHref}>{lang === 'ru' ? 'English' : 'Русский'}</a>
    </div>

    <main id="main">
      <!-- Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__in">
          <div class="hero__copy">
            <h1 id="hero-title" class="hero__title">
              {t.hero.title.map((line, i) => <span class="hero__line" style={`--i:${i}`}><span>{line}</span></span>)}
            </h1>
            <p class="hero__lead">{t.hero.lead}</p>
            <div class="stores" id="download">
              <a class="store" href={STORE.ios} rel="noopener" target="_blank"><Fragment set:html={apple} /><span><small>{t.hero.ios}</small>{t.hero.iosStore}</span></a>
              <a class="store" href={STORE.android} rel="noopener" target="_blank"><Fragment set:html={play} /><span><small>{t.hero.android}</small>{t.hero.androidStore}</span></a>
            </div>
            <p class="hero__note">{t.hero.note}</p>
          </div>

          <div class="hero__stage">
            <div class="wall" role="img" aria-label={t.hero.wall} data-wall>
              {
                cells.map((cell, i) => (
                  <div class="cell" style={`--c:${cell.col};--r:${cell.row};--d:${i}`}>
                    <div class="cell__face" />
                    <div class="cell__back">
                      <img src={`/people/${faces[i % faces.length]}.webp`} alt="" decoding="async" />
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="phone phone--hero" aria-hidden="true">
              <img src="/screens/t_feed.webp" alt="" />
            </div>
            <div class="toast toast--urgent" aria-hidden="true"><span class="toast__dot"><Fragment set:html={fire} /></span><b>Urgent hiring</b></div>
            <div class="toast toast--apply" aria-hidden="true">
              <img src="/people/f-pink-skirt.webp" alt="" /><span><b>{lang === 'ru' ? 'Новый отклик' : 'New applicant'}</b>Layla H. · Hostess</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Roles: scroll story -->
      <section class="roles" id="how" aria-labelledby="roles-title" data-roles data-role="talent">
        <div class="wrap">
          <div class="roles__head">
            <h2 id="roles-title" class="h2">{t.roles.title}</h2>
            <p class="lead">{t.roles.lead}</p>
            <div class="switch" role="tablist" aria-label={t.roles.title}>
              <button role="tab" aria-selected="true" data-role-tab="talent">{t.roles.talentTab}</button>
              <button role="tab" aria-selected="false" data-role-tab="employer">{t.roles.employerTab}</button>
              <span class="switch__pill" aria-hidden="true"></span>
            </div>
          </div>

          {
            (['talent', 'employer'] as const).map((role) => (
              <div class="story" data-story={role} hidden={role === 'employer'}>
                <ol class="story__steps">
                  {steps[role].map((s, i) => (
                    <li class="step" data-step={i}>
                      <span class="step__n" aria-hidden="true">{i + 1}</span>
                      <h3 class="step__title">{s.title}</h3>
                      <p class="step__text">{s.text}</p>
                      <div class="phone phone--inline">
                        <img src={`/screens/${s.screen}.webp`} alt={s.alt} loading="lazy" decoding="async" />
                      </div>
                    </li>
                  ))}
                </ol>
                <div class="story__stage" aria-hidden="true">
                  <div class="phone phone--story">
                    {steps[role].map((s, i) => (
                      <img src={`/screens/${s.screen}.webp`} alt="" class={i === 0 ? 'is-on' : ''} data-shot={i} loading="lazy" decoding="async" />
                    ))}
                  </div>
                  <div class="story__dots">
                    {steps[role].map((_, i) => (
                      <span class={i === 0 ? 'is-on' : ''} data-dot={i} />
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Features -->
      <section class="features" id="features" aria-labelledby="features-title">
        <div class="wrap">
          <h2 id="features-title" class="h2 h2--light">{t.features.title}</h2>
          <div class="bento">
            <article class="tile tile--video">
              <div class="tile__copy">
                <h3>{t.features.video.title}</h3>
                <p>{t.features.video.text}</p>
              </div>
              <div class="phone tile__phone" aria-hidden="true">
                <div class="reel">
                  <video class="is-on" poster="/video/reel-neon.webp" autoplay muted playsinline preload="auto" data-reel-video>
                    <source src="/video/reel-neon.mp4" type='video/mp4; codecs="avc1.4D401F"' />
                    <source src="/video/reel-neon.webm" type="video/webm" />
                  </video>
                  <video muted playsinline preload="auto" data-reel-video>
                    <source src="/video/reel-desert.mp4" type='video/mp4; codecs="avc1.4D401F"' />
                    <source src="/video/reel-desert.webm" type="video/webm" />
                  </video>
                  <video muted playsinline preload="auto" data-reel-video>
                    <source src="/video/reel-drums.mp4" type='video/mp4; codecs="avc1.4D401F"' />
                    <source src="/video/reel-drums.webm" type="video/webm" />
                  </video>
                </div>
              </div>
            </article>

            <article class="tile tile--urgent">
              <span class="badge-urgent"><Fragment set:html={fire} />Urgent</span>
              <div class="clock" aria-hidden="true"><span data-clock>23:59:59</span><small>{t.features.urgent.clock}</small></div>
              <h3>{t.features.urgent.title}</h3>
              <p>{t.features.urgent.text}</p>
              <span class="tile__price">{t.features.urgent.price}</span>
            </article>

            <article class="tile tile--mod">
              <div class="states" aria-hidden="true" data-states>
                {t.features.moderation.states.map((s, i) => (
                  <span class={`state state--${i}`}>
                    {i === 2 ? <Fragment set:html={check} /> : null}
                    {s}
                  </span>
                ))}
              </div>
              <h3>{t.features.moderation.title}</h3>
              <p>{t.features.moderation.text}</p>
            </article>

            <article class="tile tile--avail">
              <div class="avail__copy">
                <span class="badge-avail"><Fragment set:html={flash} />Available today</span>
                <h3>{t.features.avail.title}</h3>
                <p>{t.features.avail.text}</p>
              </div>
              <div class="avail__demo" aria-hidden="true">
                <div class="avail__toggle" data-avail>
                  <span class="avail__ic"><Fragment set:html={flash} /></span>
                  <span class="avail__txt"><b>{t.features.avail.toggle}</b><small>{t.features.avail.sub}</small></span>
                  <span class="avail__sw"><i></i></span>
                </div>
                <div class="avail__cards">
                  {availFaces.map((x, i) => (
                    <figure class="avail__card" style={`--i:${i}`}>
                      <img src={`/people/${x.f}.webp`} alt="" loading="lazy" decoding="async" />
                      <span class="avail__pill"><Fragment set:html={flash} /><span class="avail__today">Today · </span>{t.features.avail.when[i]}</span>
                      <figcaption>{x.name}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            </article>

            <article class="tile tile--chats">
              <div class="chips" aria-hidden="true" data-chips>
                {t.features.chats.chips.map((s, i) => <span class={i === 1 ? 'is-on' : ''}>{s}</span>)}
              </div>
              <h3>{t.features.chats.title}</h3>
              <p>{t.features.chats.text}</p>
            </article>

            <article class="tile tile--team">
              <div class="faces" aria-hidden="true">
                {['f-makeup', 'f-headphones', 'f-yellow-suit'].map((f) => <img src={`/people/${f}.webp`} alt="" loading="lazy" />)}
              </div>
              <h3>{t.features.team.title}</h3>
              <p>{t.features.team.text}</p>
            </article>
          </div>
        </div>
      </section>

      <!-- Fields -->
      <section class="fields" aria-labelledby="fields-title" data-fields>
        <div class="wrap">
          <div class="fields__head">
            <h2 id="fields-title" class="h2">{t.fields.title}</h2>
            <p class="lead">{t.fields.lead}</p>
          </div>
          <ul class="fields__list">
            {
              t.fields.list.map((f) => (
                <li class="field">
                  <span class="field__name">{f.name}</span>
                  <span class="field__roles">{f.roles}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Pricing -->
      <section class="pricing" id="pricing" aria-labelledby="pricing-title">
        <div class="wrap">
          <div class="pricing__head">
            <h2 id="pricing-title" class="h2">{t.pricing.title}</h2>
            <p class="lead">{t.pricing.lead}</p>
            <div class="switch switch--plans" role="tablist" aria-label={t.pricing.title} data-plans-switch>
              <button role="tab" aria-selected="true" data-plan-tab="talent">{t.pricing.talentTab}</button>
              <button role="tab" aria-selected="false" data-plan-tab="employer">{t.pricing.employerTab}</button>
              <span class="switch__pill" aria-hidden="true"></span>
            </div>
          </div>
          {
            (['talent', 'employer'] as const).map((side) => (
              <div class="plans" data-plans={side} hidden={side === 'employer'}>
                {plans[side].map((p) => (
                  <article class={`plan ${p.featured ? 'plan--featured' : ''} ${p.badge === 'max' ? 'plan--max' : ''} ${p.urgent ? 'plan--urgent' : ''}`}>
                    <h3 class="plan__name">
                      {p.badge ? <span class={`plan__badge plan__badge--${p.badge}`}><Fragment set:html={star} /></span> : null}
                      {p.urgent ? <span class="plan__badge plan__badge--urgent"><Fragment set:html={fire} /></span> : null}
                      {p.name}
                    </h3>
                    <p class="plan__price">
                      {p.price}
                      {p.per ? <small>{p.per}</small> : null}
                    </p>
                    <ul>
                      {p.points.map((x) => (
                        <li>
                          <Fragment set:html={check} />
                          {x}
                        </li>
                      ))}
                    </ul>
                    <a class={`btn ${p.featured ? 'btn--light' : 'btn--ink'}`} href="#download">
                      {p.cta}
                    </a>
                  </article>
                ))}
              </div>
            ))
          }
        </div>
      </section>

      <!-- FAQ -->
      <section class="faq" id="faq" aria-labelledby="faq-title">
        <div class="wrap faq__in">
          <h2 id="faq-title" class="h2">{t.faq.title}</h2>
          <div class="faq__list">
            {
              t.faq.items.map(([q, a]) => (
                <details class="qa">
                  <summary>
                    {q}
                    <span class="qa__ic" aria-hidden="true" />
                  </summary>
                  <p>{a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta" aria-labelledby="cta-title">
        <div class="cta__pattern" aria-hidden="true"></div>
        <div class="wrap cta__in">
          <div class="cta__copy">
            <h2 id="cta-title" class="cta__title">{t.cta.title}</h2>
            <p>{t.cta.text}</p>
            <div class="stores stores--dark">
              <a class="store" href={STORE.ios} rel="noopener" target="_blank"><Fragment set:html={apple} /><span><small>{t.hero.ios}</small>{t.hero.iosStore}</span></a>
              <a class="store" href={STORE.android} rel="noopener" target="_blank"><Fragment set:html={play} /><span><small>{t.hero.android}</small>{t.hero.androidStore}</span></a>
            </div>
          </div>
          <div class="phone cta__phone" aria-hidden="true">
            <div class="reel">
              <video class="is-on" poster="/video/reel-auth.webp" autoplay muted loop playsinline preload="metadata" data-loop-video>
                <source src="/video/reel-auth.mp4" type='video/mp4; codecs="avc1.4D401F"' />
                <source src="/video/reel-auth.webm" type="video/webm" />
              </video>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <a href={lang === 'ru' ? '/ru/' : '/'} class="foot__logo" aria-label="919"><Fragment set:html={logo} /></a>
        <nav class="foot__links" aria-label="Footer">
          <a href="#how">{t.nav.talent}</a>
          <a href="#how" data-role-link="employer">{t.nav.employers}</a>
          <a href="#pricing">{t.nav.pricing}</a>
          <a href="#faq">{t.nav.faq}</a>
          <a href={t.nav.langHref}>{lang === 'ru' ? 'English' : 'Русский'}</a>
        </nav>
        <div class="foot__social">
          <a href={SOCIAL.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <p class="foot__rights">{t.footer.rights}</p>
      </div>
    </footer>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Nav: solid after the hero; mobile menu.
      const nav = document.querySelector<HTMLElement>('[data-nav]')!;
      const onScroll = () => nav.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      const burger = document.querySelector<HTMLButtonElement>('[data-burger]')!;
      const menu = document.querySelector<HTMLElement>('[data-menu]')!;
      const setMenu = (open: boolean) => {
        burger.setAttribute('aria-expanded', String(open));
        menu.hidden = !open;
        document.body.classList.toggle('menu-open', open);
      };
      burger.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
      menu.addEventListener('click', (e) => (e.target as HTMLElement).closest('a') && setMenu(false));

      // Casting wall: cells flip to faces, a few at a time.
      const wall = document.querySelector<HTMLElement>('[data-wall]');
      if (wall && !reduce) {
        const cells = [...wall.querySelectorAll<HTMLElement>('.cell')];
        const busy = new Set<HTMLElement>();
        const flip = () => {
          const free = cells.filter((c) => !busy.has(c));
          if (busy.size < 5 && free.length) {
            const c = free[Math.floor(Math.random() * free.length)];
            busy.add(c);
            c.classList.add('is-flipped');
            setTimeout(() => {
              c.classList.remove('is-flipped');
              setTimeout(() => busy.delete(c), 700);
            }, 2600 + Math.random() * 1800);
          }
        };
        setTimeout(() => {
          [0, 5, 10].forEach((i) => cells[i] && (busy.add(cells[i]), cells[i].classList.add('is-flipped')));
          setTimeout(() => [0, 5, 10].forEach((i) => (cells[i].classList.remove('is-flipped'), setTimeout(() => busy.delete(cells[i]), 700))), 3200);
        }, 900);
        setInterval(flip, 650);
      }

      // Roles: switch sides; the phone follows the step in view.
      const roles = document.querySelector<HTMLElement>('[data-roles]')!;
      const tabs = [...roles.querySelectorAll<HTMLButtonElement>('[data-role-tab]')];
      const setRole = (role: string) => {
        roles.dataset.role = role;
        tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.roleTab === role)));
        roles.querySelectorAll<HTMLElement>('[data-story]').forEach((s) => (s.hidden = s.dataset.story !== role));
      };
      tabs.forEach((b) => b.addEventListener('click', () => setRole(b.dataset.roleTab!)));
      document.querySelectorAll<HTMLAnchorElement>('[data-role-link]').forEach((a) => a.addEventListener('click', () => setRole(a.dataset.roleLink!)));
      document.querySelectorAll<HTMLAnchorElement>('a[href="#how"]:not([data-role-link])').forEach((a) => a.addEventListener('click', () => setRole('talent')));

      // One active step per story: the one whose text is closest to the viewport centre.
      // Text, phone screen and dots switch together, on the same frame.
      const setStep = (story: HTMLElement, n: string) => {
        story.querySelectorAll<HTMLElement>('.step').forEach((s) => s.classList.toggle('is-on', s.dataset.step === n));
        story.querySelectorAll<HTMLElement>('[data-shot]').forEach((img) => img.classList.toggle('is-on', img.dataset.shot === n));
        story.querySelectorAll<HTMLElement>('[data-dot]').forEach((d) => d.classList.toggle('is-on', d.dataset.dot === n));
      };
      let ticking = false;
      const syncSteps = () => {
        ticking = false;
        const mid = window.innerHeight / 2;
        roles.querySelectorAll<HTMLElement>('[data-story]:not([hidden])').forEach((story) => {
          let best: HTMLElement | null = null;
          let dist = Infinity;
          story.querySelectorAll<HTMLElement>('.step').forEach((s) => {
            const r = (s.querySelector('.step__title') ?? s).getBoundingClientRect();
            const d = Math.abs(r.top + r.height / 2 - mid);
            if (d < dist) (dist = d), (best = s);
          });
          if (best && !(best as HTMLElement).classList.contains('is-on')) setStep(story, (best as HTMLElement).dataset.step!);
        });
      };
      const onStoryScroll = () => {
        if (!ticking) (ticking = true), requestAnimationFrame(syncSteps);
      };
      window.addEventListener('scroll', onStoryScroll, { passive: true });
      window.addEventListener('resize', onStoryScroll);
      tabs.forEach((b) => b.addEventListener('click', onStoryScroll));
      roles.querySelectorAll('[data-story]').forEach((s) => s.querySelector('.step')?.classList.add('is-on'));

      // Video presentations play one after another, round and round; still for reduced motion.
      const reel = [...document.querySelectorAll<HTMLVideoElement>('[data-reel-video]')];
      if (reduce) [...reel, ...document.querySelectorAll<HTMLVideoElement>('[data-loop-video]')].forEach((v) => v.pause());
      else
        reel.forEach((v, k) =>
          v.addEventListener('ended', () => {
            const next = reel[(k + 1) % reel.length];
            next.currentTime = 0;
            next.play().catch(() => {});
            next.classList.add('is-on');
            if (next !== v) v.classList.remove('is-on');
          }),
        );

      // Pricing: talent / employer plans.
      const plansSwitch = document.querySelector<HTMLElement>('[data-plans-switch]');
      if (plansSwitch) {
        const ptabs = [...plansSwitch.querySelectorAll<HTMLButtonElement>('[data-plan-tab]')];
        ptabs.forEach((b) =>
          b.addEventListener('click', () => {
            const side = b.dataset.planTab!;
            plansSwitch.dataset.side = side;
            ptabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
            document.querySelectorAll<HTMLElement>('[data-plans]').forEach((g) => (g.hidden = g.dataset.plans !== side));
          }),
        );
      }

      // Available today: the switch turns on when the tile scrolls into view, then the cards pop in.
      const avail = document.querySelector<HTMLElement>('[data-avail]');
      if (avail) {
        const tile = avail.closest('.tile')!;
        if (reduce) tile.classList.add('is-on');
        else
          new IntersectionObserver(
            (es, o) =>
              es.forEach((e) => {
                if (!e.isIntersecting) return;
                setTimeout(() => tile.classList.add('is-on'), 500);
                o.disconnect();
              }),
            { threshold: 0.5 },
          ).observe(tile);
      }

      // Urgent: a live 24-hour countdown.
      const clock = document.querySelector<HTMLElement>('[data-clock]');
      if (clock) {
        const end = Date.now() + (23 * 3600 + 59 * 60 + 59) * 1000;
        const pad = (n: number) => String(n).padStart(2, '0');
        const tick = () => {
          const s = Math.max(0, Math.floor((end - Date.now()) / 1000));
          clock.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}`;
        };
        tick();
        setInterval(tick, 1000);
      }

      // Moderation states and chat contexts take turns.
      const cycle = (sel: string, child: string, ms: number) => {
        const root = document.querySelector(sel);
        if (!root || reduce) return;
        const items = [...root.querySelectorAll<HTMLElement>(child)];
        let i = items.findIndex((x) => x.classList.contains('is-on'));
        setInterval(() => {
          items.forEach((x) => x.classList.remove('is-on'));
          i = (i + 1) % items.length;
          items[i].classList.add('is-on');
        }, ms);
      };
      cycle('[data-states]', '.state', 1600);
      cycle('[data-chips]', 'span', 1800);
    </script>
  </body>
</html>
